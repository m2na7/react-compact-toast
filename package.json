{
  "name": "react-compact-toast",
  "version": "0.3.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m2na7/react-compact-toast.git"
  },
  "license": "MIT",
  "author": "m2na7",
  "description": "A tiny, compact, and fully customizable toast notification library.",
  "keywords": [
    "react",
    "toast",
    "notification",
    "react-compact-toast",
    "compact",
    "customizable",
    "react-toast",
    "snackbar",
    "message",
    "alert"
  ],
  "type": "commonjs",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.mts",
        "default": "./dist/headless.mjs"
      },
      "require": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "headless"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "cypress run --component",
    "test:browser:open": "cypress open --component",
    "test:package": "node scripts/check-package.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p cypress/tsconfig.json",
    "check": "pnpm lint && pnpm format:check && pnpm type-check && pnpm test && pnpm build && pnpm test:package",
    "playground": "pnpm --filter playground dev",
    "playground:build": "pnpm --filter playground build",
    "prepack": "pnpm build",
    "prepare": "lefthook install"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "semi": true,
    "trailingComma": "es5",
    "useTabs": false,
    "singleQuote": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "cypress": "^16.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "next": "^16.3.4",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "packageManager": "pnpm@10.34.5"
}
